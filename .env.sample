# LLM API key (required)
# Get yours at https://console.groq.com
GROQ_API_KEY=

# Model to use (optional, defaults to llama-3.3-70b-versatile)
MODEL=llama-3.3-70b-versatile

# Search API key (optional, falls back to DuckDuckGo/SearXNG/Google)
# Get yours at https://app.tavily.com
TAVILY_API_KEY=

# Server port (optional, defaults to 3001)
PORT=3001

# Database connection (optional, defaults to postgres://localhost:5432/scaff?sslmode=disable)
DATABASE_URL=postgres://scaff:scaff@localhost:5432/scaff?sslmode=disable
